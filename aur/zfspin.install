post_install() {
    echo ">>> zfspin installed!"
    echo ">>> "
    echo ">>> To enable kernel package locking (recommended):"
    echo ">>>   sudo zfspin lock enable"
    echo ">>> "
    echo ">>> To enable automatic weekly updates:"
    echo ">>>   sudo systemctl enable --now zfspin-update.timer"
    echo ">>> "
    echo ">>> For safe manual updates:"
    echo ">>>   sudo zfspin update"
}

post_upgrade() {
    post_install
}

post_remove() {
    echo ">>> zfspin removed"
    echo ">>> "
    echo ">>> Remember to:"
    echo ">>>   - Disable the update timer: sudo systemctl disable zfspin-update.timer"
    echo ">>>   - Unlock kernel packages if locked: check /etc/pacman.conf for IgnorePkg"
}
