post_install() {
    echo ""
    echo "zfspin installed successfully!"
    echo ""
    echo "Quick start:"
    echo "  1. Enable kernel package locking (recommended):"
    echo "     sudo zfspin lock enable"
    echo ""
    echo "  2. Enable automatic weekly updates:"
    echo "     sudo systemctl enable --now zfspin-update.timer"
    echo ""
    echo "  3. For safe manual updates:"
    echo "     sudo zfspin update"
    echo ""
    echo "For more information: zfspin --help"
}

post_upgrade() {
    echo ""
    echo "zfspin upgraded to version $1"
    echo ""
}

post_remove() {
    echo ""
    echo "zfspin has been removed."
    echo ""
    echo "Remember to:"
    echo "  - Disable the update timer:"
    echo "    sudo systemctl disable zfspin-update.timer"
    echo "  - Unlock kernel packages if locked:"
    echo "    Check /etc/pacman.conf for IgnorePkg lines with 'zfspin' marker"
    echo ""
}
